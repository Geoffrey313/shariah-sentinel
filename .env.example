# Environment for reproducing the published results.
#
# Reproduction runs entirely from the reconstructed panels shipped under data/;
# no credentials are required. Copy this file to .env.local (git-ignored) only
# if you need to override a path below.

# Raw Compustat data is licensed and is NOT redistributed with this repository
# (see the README for access by motivated request). Set this only if you are
# rebuilding the panels from your own licensed copy of the raw data.
COMPUSTAT_RAW_DIR=
