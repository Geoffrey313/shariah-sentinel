# Generated outputs — regenerated by main.py. Only the reconstructed input
# Shipped inputs: the reconstructed per-country panels
# (data/panel/<country>/compustat_quarterly.parquet) and the phase-0 reference
# split (data/scores/<country>/phase0_reference_sample/panel_with_split.parquet).
# Everything else under data/ is produced by a run (see `python main.py pipeline`).
data/scores/*/z_scores.*
data/scores/*/zscores/
data/scores/*/composites.*
data/scores/*/phase1_*/
data/scores/*/phase2_*/
data/scores/*/phase3_*/
data/scores/*/phase4_*/
data/scores/*/phase5_*/
data/scores/*/phase6_*/
data/scores/*/phase7_*/
data/scores/*/robustness_benchmark/
data/scores/*/dashboard/
data/scores/*/figures/
data/scores/*/phase4b_confidence/
data/scores/*/qualitative/
data/scores/*/contamination/
# Phase-0 deliverables are regenerated; only the reference split is shipped.
data/scores/*/phase0_reference_sample/*
!data/scores/*/phase0_reference_sample/panel_with_split.parquet

