# Caches and environments
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store
.venv/
venv/

# Manuscripts live in the workspace but are NEVER published (EN, FR, journal versions)
manuscript/

# Internal working dir: audit outputs, notes, drafts, reviews
docs/internal/
review/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.out
*.toc
*.synctex.gz

# The reconstructed PANELS carry licensed S&P Compustat fields, so they are not
# tracked (obtain them on motivated request; see the README). What IS shipped:
#  - data/README.md (schema documentation);
#  - data/raw/macro_connectors/ (Islamic-correction macro series; public sources);
#  - data/scores/ (de-identified derived outputs: z-scores, composite p/q-values,
#    verdicts and reduced tables, firm keys replaced by synthetic ids, no Compustat
#    fields) — enough to regenerate every reported result without the panels.
data/*
!data/README.md
!data/scores/
!data/raw/

# Generated results are reproducible by the code, never stored
results/
outputs/
figures/data/

# A fresh `reproduce.py numbers` run writes here; diff it against the tracked
# reference numbers_manifest.json. Never commit the local run.
numbers_manifest.local.json
